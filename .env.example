# ===== 节点角色 =====
# standalone = 单机彩排/演示（默认，全部功能本地跑，不联网）
# cloud      = 云端节点（公网服务器：微信签到 + 用户页）
# local      = 现场本地节点（开奖引擎 + 大屏 + 管理台，断外网可用）
ROLE=standalone

# ===== 基础 =====
PORT=3000
# 本节点对外访问地址（云端必须为 https://已备案域名，微信授权回调域名要与此一致）
BASE_URL=http://localhost:3000

# ===== 仅 ROLE=local 需要 =====
# 用户扫码应访问的云端公网地址（大屏二维码/本地 / 跳转用）
CLOUD_PUBLIC_URL=
# 云端 API 地址（本地节点同步用，与 CLOUD_PUBLIC_URL 相同即可，内网互通时也可填内网地址）
CLOUD_URL=

# ===== 安全密钥（云端与本地必须配同一对）=====
PAIR_KEY=change-me-pair-key
ADMIN_KEY=change-me-admin-key
# 签名 Cookie 密钥（任意随机长串，各节点独立即可）
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars

# ===== 微信服务号（云端真实签到用；USE_MOCK=1 时走模拟登录）=====
USE_MOCK=1
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 同步节奏（可选）=====
SYNC_PULL_INTERVAL_MS=3000
SYNC_PUSH_INTERVAL_MS=5000
